PORT=5000
CLIENT_URL=http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/kenora-qr-studio
JWT_SECRET=replace-with-a-long-random-secret
BCRYPT_ROUNDS=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Generate a long random value for a protected Render Cron Job calling /api/media/internal/cleanup
MEDIA_CLEANUP_SECRET=
# Optional lower limits; the code never permits files above the Cloudinary Free caps (10 MB images, 100 MB videos).
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_MAX_FILES=100
MEDIA_MAX_SHARE_BYTES=2147483648
MEDIA_CONCURRENT_UPLOADS=3
